%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 38e7c4ca019473b4ca84847ec61caaa6, type: 3}
  m_Name: Prologue
  m_EditorClassIdentifier: 
  startScripts:
  - scriptID: SCRIPT_PROLOGUE_1
    chapterID: 0
    eventID: 0
    scriptText: "\uBB34\uBA85 \uC561\uC158 \uBC30\uC6B0\uB85C \uADFC\uADFC\uC774
      \uC0DD\uACC4\uB97C \uC774\uC5B4\uAC00\uB358 \u2018\uAE40\uBC30\uC6B0\u2019."
    delayTime: 2
  - scriptID: SCRIPT_PROLOGUE_2
    chapterID: 0
    eventID: 0
    scriptText: 
    delayTime: 1
  - scriptID: SCRIPT_PROLOGUE_3
    chapterID: 0
    eventID: 0
    scriptText: "\uD558\uB8E8\uD558\uB8E8 \uBC84\uD2F0\uB358 \uADF8\uB140\uC5D0\uAC8C
      \uC5B4\uB290 \uB0A0 \uB0AF\uC120 \uBB38\uC790 \uD55C \uD1B5\uC774 \uB3C4\uCC29\uD588\uB2E4."
    delayTime: 2
  - scriptID: SCRIPT_PROLOGUE_4
    chapterID: 0
    eventID: 0
    scriptText: 
    delayTime: 1
  - scriptID: SCRIPT_PROLOGUE_5
    chapterID: 0
    eventID: 0
    scriptText: "<i>'\uC548\uB155\uD558\uC138\uC694 \uAE40\uBC30\uC6B0\uB2D8.'"
    delayTime: 2
  - scriptID: SCRIPT_PROLOGUE_6
    chapterID: 0
    eventID: 0
    scriptText: "\uC601\uD654 \u2018\uAC80\uC131\uC758 \uBAA8\uD5D8\uB2F4\u2019\uC758
      \uC8FC\uC778\uACF5\uC744 \uB9E1\uC544 \uC8FC\uC168\uC73C\uBA74 \uD569\uB2C8\uB2E4."
    delayTime: 2
  - scriptID: SCRIPT_PROLOGUE_7
    chapterID: 0
    eventID: 0
    scriptText: 
    delayTime: 1
  - scriptID: SCRIPT_PROLOGUE_8
    chapterID: 0
    eventID: 0
    scriptText: "\uC644\uC131 \uC2DC\uAE30\uB97C \uC7A5\uB2F4\uD560 \uC218 \uC5C6\uACE0
      \uCD2C\uC601\uC774 \uC2DC\uC791\uB418\uBA74 \uC7A5\uAE30\uAC04 \uD604\uC7A5\uC5D0\uC11C
      \uBA38\uBB3C\uB7EC\uC57C \uD560\uC9C0\uB3C4 \uBAA8\uB985\uB2C8\uB2E4."
    delayTime: 2
  - scriptID: SCRIPT_PROLOGUE_9
    chapterID: 0
    eventID: 0
    scriptText: "\uD798\uB4E0 \uC0C1\uD669\uC774 \uB2E5\uCE60 \uC218 \uC788\uC9C0\uB9CC
      \uBD80\uB514 \u2018\uAE40\uBC30\uC6B0\uB2D8\u2019\uC744 \uC800\uD76C \uC601\uD654\uC758
      \uC8FC\uC778\uACF5\uC73C\uB85C \uBAA8\uC2DC\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4.'</i>"
    delayTime: 2
  - scriptID: SCRIPT_PROLOGUE_10
    chapterID: 0
    eventID: 0
    scriptText: 
    delayTime: 1
  - scriptID: SCRIPT_PROLOGUE_11
    chapterID: 0
    eventID: 0
    scriptText: "\uB9C9\uB9C9\uD55C \uBBF8\uB798 \uC18D\uC5D0\uC11C \uC774\uB7F0
      \uAE30\uD68C\uB294 \uD754\uCE58 \uC54A\uC558\uB2E4."
    delayTime: 2
  - scriptID: SCRIPT_PROLOGUE_12
    chapterID: 0
    eventID: 0
    scriptText: "\uC758\uC2EC\uC2A4\uB7EC\uC6E0\uC9C0\uB9CC\u2026 \uBC30\uC6B0\uB85C
      \uC0B4\uC544\uB0A8\uAE30 \uC704\uD574 \uADF8\uB140\uB294 \uACB0\uC815\uC744
      \uB0B4\uB838\uB2E4."
    delayTime: 2
  - scriptID: SCRIPT_PROLOGUE_13
    chapterID: 0
    eventID: 0
    scriptText: 
    delayTime: 1
  - scriptID: SCRIPT_PROLOGUE_14
    chapterID: 0
    eventID: 0
    scriptText: "\uC218\uB77D\uD558\uACA0\uC2B5\uB2C8\uB2E4.'"
    delayTime: 2
  - scriptID: SCRIPT_PROLOGUE_15
    chapterID: 0
    eventID: 0
    scriptText: 
    delayTime: 1
  - scriptID: SCRIPT_PROLOGUE_16
    chapterID: 0
    eventID: 0
    scriptText: "\uBB38\uC790\uB97C \uC804\uC1A1\uD558\uB294 \uC21C\uAC04 \uB208\uBD80\uC2E0
      \uBE5B\uC774 \uADF8\uB140\uB97C \uAC10\uC2F8 \uC548\uC558\uB2E4."
    delayTime: 2
  - scriptID: SCRIPT_PROLOGUE_17
    chapterID: 0
    eventID: 0
    scriptText: "\uADF8\uB9AC\uACE0 \uC138\uC0C1\uC5D0\uC11C \uC0AC\uB77C\uC84C\uB2E4."
    delayTime: 4
  - scriptID: SCRIPT_PROLOGUE_18
    chapterID: 0
    eventID: 0
    scriptText: ' '
    delayTime: 1
  - scriptID: SCRIPT_PROLOGUE_19
    chapterID: 0
    eventID: 0
    scriptText: "\uC2E0\uACFC \uB9C8\uC655\uC774 \uC874\uC7AC\uD558\uACE0 \uAC80\uACFC
      \uB9C8\uBC95\uC774 \uACF5\uC874\uD558\uB294 \uC138\uACC4 \u2018\uC774\uC2A4\uD14C\uB3C8\u2019."
    delayTime: 2
  - scriptID: SCRIPT_PROLOGUE_20
    chapterID: 0
    eventID: 0
    scriptText: 
    delayTime: 1
  - scriptID: SCRIPT_PROLOGUE_21
    chapterID: 0
    eventID: 0
    scriptText: "\uADF8\uACF3\uC5D0\uB294 \uB2E8\uC2E0\uC73C\uB85C \uB2E8 \uD558\uB098\uC758
      \uAC80\uC73C\uB85C \uB9C8\uC655\uC744 \uC4F0\uB7EC\uB728\uB9B0 \uC804\uC124\uC758
      \uAC80\uC131 \u2018\uC5D8\u2019\uC774 \uC788\uC5C8\uB2E4."
    delayTime: 2
  - scriptID: SCRIPT_PROLOGUE_22
    chapterID: 0
    eventID: 0
    scriptText: 
    delayTime: 1
  - scriptID: SCRIPT_PROLOGUE_23
    chapterID: 0
    eventID: 0
    scriptText: "\uB2F9\uC2E0\uC740 \uADF8 \uC601\uC6C5\uB2F4\uC744 \uC601\uD654\uB85C
      \uB0A8\uAE30\uAE30 \uC704\uD574 \uC18C\uD658\uB41C \uC0AC\uB78C."
    delayTime: 2
  - scriptID: SCRIPT_PROLOGUE_24
    chapterID: 0
    eventID: 0
    scriptText: "\uC5D8\uC758 \uC5B4\uB9B0 \uC2DC\uC808\uBD80\uD130 \uB9C8\uCE68\uB0B4
      \uB9C8\uC655\uC744 \uBB34\uCC0C\uB978 \uC21C\uAC04\uAE4C\uC9C0\u2014"
    delayTime: 2
  - scriptID: SCRIPT_PROLOGUE_25
    chapterID: 0
    eventID: 0
    scriptText: 
    delayTime: 1
  - scriptID: SCRIPT_PROLOGUE_26
    chapterID: 0
    eventID: 0
    scriptText: "\uADF8 \uBC1C\uC790\uCDE8\uB97C \uB530\uB77C\uAC00\uBA70 \uADF8\uB140\uAC00
      \uACAA\uC740 \uBAA8\uD5D8\uACFC \uC2DC\uB828\uC744 \uC7AC\uD604\uD558\uB77C."
    delayTime: 2
  - scriptID: SCRIPT_PROLOGUE_27
    chapterID: 0
    eventID: 0
    scriptText: "\uBAA8\uB4E0 \uC7A5\uBA74\uC744 \uC644\uC131\uD588\uC744 \uB54C
      \uC601\uD654\uB294 \uC804\uC124\uC774 \uB418\uACE0."
    delayTime: 2
  - scriptID: SCRIPT_PROLOGUE_28
    chapterID: 0
    eventID: 0
    scriptText: 
    delayTime: 1
  - scriptID: SCRIPT_PROLOGUE_29
    chapterID: 0
    eventID: 0
    scriptText: "\uB2F9\uC2E0\uC758 \uC774\uC57C\uAE30\uB294 \u2018\uAC80\uC131\uC758
      \uBAA8\uD5D8\uB2F4\u2019\uC774 \uB41C\uB2E4."
    delayTime: 2
